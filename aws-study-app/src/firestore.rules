rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Função utilitária para checar se o usuário é Administrador
    function isAdmin() {
      return request.auth != null && (
        request.auth.uid == 'Wafgz4MpWUXOf7TKREcC9yZ5k073' ||
        request.auth.uid == 'fy9fGuWe5Kh4veCFkRbp6pN9MyK2' ||
        request.auth.token.email == 'felps.st2020@gmail.com' ||
        request.auth.token.email == 'lucasft.pwa@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isUnlimited == true))
      );
    }

    // Regras para a coleção de trilhas globais 'globalTrails' (públicas para todos os alunos)
    match /globalTrails/{trailId} {
      allow read: if request.auth != null;
      allow write, create, update, delete: if request.auth != null;
    }

    // Regras para a coleção de escolas/colégios multi-tenant 'schools'
    match /schools/{schoolId} {
      allow read: if request.auth != null;
      allow write, create, update, delete: if request.auth != null;

      match /subjects/{subjectId} {
        allow read: if request.auth != null;
        allow write, create, update, delete: if request.auth != null;
      }

      // Desempenho dos alunos por matéria (acertos/erros em quizzes)
      match /performance/{perfId} {
        allow read: if request.auth != null;
        allow write, create, update, delete: if request.auth != null;
      }

      // Placar de pontuação por colégio (XP específico da escola)
      match /scores/{scoreId} {
        allow read: if request.auth != null;
        allow write, create, update, delete: if request.auth != null;
      }
    }

    // Regras para configurações globais do sistema ('announcement', 'aiConfig')
    match /systemSettings/{settingId} {
      allow read: if request.auth != null;
      allow write, create, update: if request.auth != null;
    }

    // Regras para logs de auditoria do Admin ('adminAuditLogs')
    match /adminAuditLogs/{logId} {
      allow read, create: if request.auth != null;
      allow update, delete: if isAdmin();
    }

    // Regras para a coleção 'users'
    match /users/{userId} {
      allow read, write, create, update, delete: if request.auth != null;

      // Regra para a subcoleção 'customTrails'
      match /customTrails/{trailId} {
        allow read, write, create, update, delete: if request.auth != null;
      }

      // Regra para a subcoleção 'studyLevelProgress'
      match /studyLevelProgress/{levelId} {
        allow read, write, create, update, delete: if request.auth != null;
      }
    }
  }
}
